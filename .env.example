# Образец настроек. Скопируйте в файл .env и заполните.
# Файл .env в git не попадает — в нём ключи и пароли.

# dev — разработка, prod — боевой сервер
APP_ENV=dev
# Случайная длинная строка для подписи сессий. На боевом сервере — обязательно своя.
SECRET_KEY=dev-secret-change-me
# Адрес сайта: нужен для ссылок в письмах и QR-кодах
BASE_URL=http://localhost:8000
# База данных. Для разработки — файл SQLite, на сервере — PostgreSQL:
# DATABASE_URL=postgresql+psycopg://pulse:пароль@localhost:5432/pulse
DATABASE_URL=sqlite:///./pulse.db

# Рабочий телефон регистратуры ЦРБ (например, в формате +7...)
REGISTRY_PHONE=

# Yandex Cloud: YandexGPT (ИИ-помощник) и SpeechKit (озвучка)
YANDEX_FOLDER_ID=
YANDEX_API_KEY=

# Яндекс Карты, JavaScript API v3 — браузерный ключ с ограничением по HTTP Referer
YANDEX_MAPS_API_KEY=

# Почта для писем с напоминаниями
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
